    {
      "parameters": {
        "jsCode": "\nconst listas = {\n  'CONFIGURAR_LISTA_A_FAZER': 'A Fazer',\n  'CONFIGURAR_LISTA_EM_ANDAMENTO': 'Em Andamento',\n  'CONFIGURAR_LISTA_AGUARDANDO_PECAS': 'Aguardando Peças',\n  'CONFIGURAR_LISTA_CONCLUIDA': 'Concluída',\n};\n\nreturn $input.all().map(item => {\n  const cartao = item.json;\n  const protocolo = cartao.name.match(/SOL-\\d+-\\d+/)?.[0];\n\n  return {\n    json: {\n      trello_card_id: cartao.id,\n      solicitacao_id: protocolo ?? null,\n      status_trello: listas[cartao.idList] ?? 'Desconhecido',\n      trello_list_id: cartao.idList,\n      trello_card_url: cartao.url\n    }\n  };\n});\n"
      },
