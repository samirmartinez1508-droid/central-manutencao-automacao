      "id": "a8f7f971-7030-4a57-a96e-de92cf4dea22",
      "name": "Consultar Interessados da Solicitação",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\nconst interessados = $input.all().map(item => item.json);\n\nconst solicitacoes = $('Status Foi Alterado?')\n  .all(0)\n  .map(item => item.json);\n\nconst cartoes = $('Identificar Status dos Cartões')\n  .all()\n  .map(item => item.json);\n\nconst resultados = [];\n\nfor (const solicitacao of solicitacoes) {\n  const cartao = cartoes.find(\n    item => String(item.trello_card_id) ===\n      String(solicitacao.trello_card_id)\n  );\n\n  if (!cartao) {\n    throw new Error(\n      `Cartão não encontrado: ${solicitacao.solicitacao_id}`\n    );\n  }\n\n  const statusAnterior = String(solicitacao.status ?? '').trim();\n  const statusNovo = String(cartao.status_trello ?? '').trim();\n\n  // Não notificar quando o status permanece igual\n  if (statusAnterior === statusNovo) {\n    continue;\n  }\n\n  const destinatarios = new Map();\n\n  function adicionar(email, nome) {\n    const endereco = String(email ?? '').trim().toLowerCase();\n\n    if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(endereco)) {\n      return;\n    }\n\n    if (!destinatarios.has(endereco)) {\n      destinatarios.set(endereco, nome || 'Solicitante');\n    }\n  }\n\n  // Solicitante original\n  adicionar(\n    solicitacao.email_solicitante,\n    solicitacao.nome_solicitante\n  );\n\n  // Interessados vinculados a esta solicitação\n  for (const pessoa of interessados) {\n    if (\n      String(pessoa.solicitacao_id) ===\n      String(solicitacao.solicitacao_id)\n    ) {\n      adicionar(pessoa.email, pessoa.nome);\n    }\n  }\n\n  for (const [email, nome] of destinatarios) {\n    resultados.push({\n      json: {\n        solicitacao_id: solicitacao.solicitacao_id,\n        email,\n        nome,\n        status_anterior: statusAnterior,\n        status_novo: statusNovo\n      }\n    });\n  }\n}\n\nreturn resultados;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
