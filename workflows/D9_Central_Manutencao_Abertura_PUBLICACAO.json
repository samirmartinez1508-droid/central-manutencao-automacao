    {
      "parameters": {
        "jsCode": "\nconst solicitacao = $('Classificar Prioridade').first().json;\n\nconst registros = $input.all()\n  .map(item => item.json)\n  .filter(registro => registro.equipamento_id);\n\nconst duplicata = registros.find(registro =>\n  registro.equipamento_id === solicitacao.equipamento_id &&\n  String(registro.problema_id).trim() === String(solicitacao.problema_id).trim() &&\n  registro.status !== 'Concluída'\n);\n\nreturn [{\n  json: {\n    ...solicitacao,\n    duplicado: Boolean(duplicata),\n    solicitacao_existente: duplicata?.solicitacao_id ?? null\n  }\n}];\n"
      },
